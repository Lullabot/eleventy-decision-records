{
  "name": "eleventy-decision-records",
  "version": "1.0.0",
  "description": "An eleventy starter project for documenting decision records",
  "scripts": {
    "start": "npm run develop",
    "develop": "eleventy --serve",
    "build": "eleventy",
    "develop:debug": "DEBUG=Eleventy* eleventy --serve",
    "build:debug": "DEBUG=Eleventy* eleventy",
    "lint": "eslint && prettier -c .",
    "lint:fix": "eslint --fix && prettier -w",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "sample-content": "node ./scripts/generate-adrs.js"
  },
  "author": "Lullabot, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lullabot/eleventy-decision-records"
  },
  "bugs": {
    "url": "https://github.com/Lullabot/eleventy-decision-records/issues"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@eslint/js": "^10.0.",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.0.3",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@material-symbols/svg-400": "^0.40.2",
    "eleventy-plugin-toc": "^1.1.5",
    "lightningcss": "^1.32.0",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "node-html-parser": "^7.1.0"
  }
}
