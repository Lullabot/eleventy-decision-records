{
  "name": "@lullabot/eleventy-decision-records",
  "version": "1.0.0",
  "description": "An Eleventy theme plugin for documenting decision records",
  "scripts": {
    "lint": "eslint && prettier -c .",
    "lint:fix": "eslint --fix && prettier -w .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "bash bin/run-e2e.sh",
    "test:update": "bash bin/run-e2e.sh --update",
    "test:local": "playwright test"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/index.js",
    "src/config.js",
    "src/defaultConfig.json",
    "src/index.md",
    "src/about.md",
    "src/YYYYMMDD-decision-template.md",
    "src/lib",
    "src/templates",
    "src/assets"
  ],
  "peerDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "author": "Lullabot, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lullabot/eleventy-decision-records"
  },
  "bugs": {
    "url": "https://github.com/Lullabot/eleventy-decision-records/issues"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.0.3",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-bundle": "^3.0.7",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@material-symbols/svg-400": "^0.40.2",
    "@orama/orama": "^3.1.18",
    "eleventy-plugin-toc": "^1.1.5",
    "he": "^1.2.0",
    "lightningcss": "^1.32.0",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "node-html-parser": "^7.1.0",
    "nunjucks": "^3.2.4",
    "prettier-plugin-jinja-template": "^2.1.0",
    "striptags": "^3.2.0"
  },
  "lint-staged": {
    "*.js": "eslint",
    "*.{js,njk,json,md,css,yml,yaml}": "prettier --check"
  }
}
