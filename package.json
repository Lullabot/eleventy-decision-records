{
  "name": "eleventy-decision-records",
  "version": "1.0.0",
  "description": "An eleventy starter project for documenting decision records",
  "scripts": {
    "start": "npm run develop",
    "develop": "eleventy --serve",
    "build": "eleventy",
    "develop:debug": "DEBUG=Eleventy* eleventy --serve",
    "build:debug": "DEBUG=Eleventy* eleventy",
    "lint": "eslint && prettier -c .",
    "lint:ci": "eslint -o reports/eslint/issues.json -f json",
    "lint-staged": "lint-staged"
  },
  "author": "Lullabot, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lullabot/eleventy-decision-records"
  },
  "bugs": {
    "url": "https://github.com/Lullabot/eleventy-decision-records/issues"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
