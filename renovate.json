{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "automerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tugboat/config\\.yml$/"],
      "matchStrings": ["setup_(?<currentValue>\\d+)\\.x"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "description": "Keep CI (.nvmrc) and Tugboat on the same Node.js release.",
      "matchDepNames": ["node"],
      "groupName": "Node.js"
    }
  ]
}
