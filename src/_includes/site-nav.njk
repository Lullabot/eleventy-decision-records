<nav class="site-nav" aria-label="Site navigation">
  {# Logo #}
  <a href="/" aria-label="{{ site.organization }} home">
    {% icon site.icon %}
    <span class="label">{{ site.organization }}</span>
  </a>

  {# Navigation menu #}
  <div class="menu">
    {# Primary nav group #}
    <ul>
      {%- for item in navigation.primary %}
        <li>
          <a href="{{ item.url }}" aria-label="{{ item.label }}"{{ ' aria-current="page"' | safe if page.url == item.url }}>
            {% icon item.icon %}
            <span class="label">{{ item.label }}</span>
          </a>
        </li>
      {%- endfor %}
      <li>
        <button aria-label="Search">
          {% icon "search" %}
          <span class="label">Search</span>
        </button>
      </li>
    </ul>

    {# Practice area nav group #}
    <ul>
      {%- for area in practiceAreas %}
        <li>
          <a href="/practice-areas/{{ area.name | slugify }}/" aria-label="{{ area.name }}">
            {% icon area.icon %}
            <span class="label">{{ area.name }}</span>
          </a>
        </li>
      {%- endfor %}
    </ul>

    {# Utility nav group #}
    <ul>
      {%- for item in navigation.utility %}
        <li>
          <a href="{{ item.url }}" aria-label="{{ item.label }}"{{ ' aria-current="page"' | safe if page.url == item.url }}>
            {% icon item.icon %}
            <span class="label">{{ item.label }}</span>
          </a>
        </li>
      {%- endfor %}
    </ul>
  </div>

  {# Sidebar footer / toggle #}
  <footer>
    <button aria-label="Toggle sidebar" aria-expanded="false">
      {% icon "side_navigation" %}
      <span class="label">Menu</span>
    </button>
  </footer>
</nav>
