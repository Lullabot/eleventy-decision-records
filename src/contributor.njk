---
pagination:
  data: collections.contributors
  size: 1
  alias: contributor
permalink: 'contributors/{{ contributor | slugify }}/'
eleventyExcludeFromCollections: true
eleventyComputed:
  title: 'Decisions by {{ contributor }}'
  description: 'Architectural decision records contributed to by {{ contributor }}'
---

{%- set contributorAdrs = collections.adrs | byContributor(contributor) %}

<h1>Decisions by {{ contributor }}</h1>
<p class="page-description">{{ description }}</p>

<div class="adr-filters">
  <span class="adr-count"
    >{{ contributorAdrs | length }}
    decision{{ "s" if contributorAdrs | length != 1 }}</span
  >
</div>

<ol class="adr-list" reversed>
  {%- for adr in contributorAdrs %}
    <li class="adr-item">
      <div class="adr-header">
        <span class="adr-status adr-status--{{ adr.data.status }}">
          {% if adr.data.status == "accepted" %}{% icon "verified" %}{% else %}{% icon "cancel" %}{% endif %}
          {{ adr.data.status }}
        </span>
        <time datetime="{{ adr.date | isoDate }}"
          >{{ adr.date | timeSince }}</time
        >
      </div>
      <a class="adr-title" href="{{ adr.url }}">{{ adr.data.title }}</a>
      {%- if adr.data.context %}
        <p class="adr-context">{{ adr.data.context }}</p>
      {%- endif %}
      <div class="adr-meta">
        {%- if adr.data.practiceArea %}
          <span class="tag">{{ adr.data.practiceArea }}</span>
        {%- endif %}
        {%- for topic in adr.data.topics %}
          <span class="tag">{{ topic }}</span>
        {%- endfor %}
      </div>
    </li>
  {%- endfor %}
</ol>
