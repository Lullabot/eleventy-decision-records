---
layout: false
eleventyExcludeFromCollections: true
eleventyImport:
  collections: ['adrs']
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }} — {{ site.organization }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ page.url | htmlBaseUrl(site.url) }}" rel="self" />
  <link href="{{ site.url | addPathPrefixToFullUrl }}" />
  <updated>{{ collections.adrs | eleventyFeedHasUrl | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url | addPathPrefixToFullUrl }}</id>
  <author>
    <name>{{ site.organization }}</name>
  </author>
  {%- for adr in collections.adrs | eleventyFeedHasUrl | reverse %}
  {%- set absolutePostUrl = adr.url | htmlBaseUrl(site.url) %}
  <entry>
    <title>{{ adr.data.title }}</title>
    <link href="{{ absolutePostUrl }}" />
    <updated>{{ adr.date | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    {%- if adr.data.context %}
    <summary>{{ adr.data.context }}</summary>
    {%- endif %}
    {%- for topic in adr.data.topics %}
    <category term="{{ topic }}" scheme="topic" />
    {%- endfor %}
    {%- if adr.data.practiceArea %}
    <category term="{{ adr.data.practiceArea }}" scheme="practiceArea" />
    {%- endif %}
    {%- if adr.data.status %}
    <category term="{{ adr.data.status }}" scheme="status" />
    {%- endif %}
    <content type="html">{{ adr.content | renderTransforms(adr.data.page, site.url) }}</content>
  </entry>
  {%- endfor %}
</feed>
