---
pagination:
  data: collections.practiceAreas
  size: 1
  alias: area
permalink: 'practice-areas/{{ area.name | slugify }}/'
eleventyExcludeFromCollections: true
eleventyComputed:
  title: '{{ area.name }} Decisions'
  description: 'Architectural decision records for {{ area.name }}'
---

{%- set areaAdrs = collections.adrs | withPracticeArea(area.name) %}

<h1>{{ area.name }} Decisions</h1>

<p class="page-description">{{ description }}</p>
{%- set intro %}{% include "practice-area-intro/" + (area.name | slugify) + ".njk" ignore missing %}{% endset %}
{%- if not (intro | trim) %}
  {%- set intro %}{% include "practice-area-intro.njk" %}{% endset %}
{%- endif %}
{%- if intro | trim %}
  <div class="page-intro">{{ intro | safe }}</div>
{%- endif %}

<div class="adr-filters">
  <span class="adr-count"
    >{{ areaAdrs | length }} decision{{ "s" if areaAdrs | length != 1 }}</span
  >
</div>

<ol class="adr-list" reversed>
  {%- for adr in areaAdrs %}
    <li class="adr-item">
      <div class="adr-header">
        <span class="adr-status adr-status--{{ adr.data.status }}">
          {% if adr.data.status == "accepted" %}{% icon "verified" %}{% else %}{% icon "cancel" %}{% endif %}
          {{ adr.data.status }}
        </span>
        <time datetime="{{ adr.date | isoDate }}"
          >{{ adr.date | timeSince }}</time
        >
      </div>
      <a class="adr-title" href="{{ adr.url }}">{{ adr.data.title }}</a>
      {%- if adr.data.context %}
        <p class="adr-context">{{ adr.data.context }}</p>
      {%- endif %}
      <div class="adr-meta">
        {%- for topic in adr.data.topics %}
          <span class="tag">{{ topic }}</span>
        {%- endfor %}
      </div>
    </li>
  {%- endfor %}
</ol>
